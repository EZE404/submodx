# Required: change this to a strong random secret (min 32 chars)
SECRET_WORD=change-me-to-a-strong-random-secret
# Without trailing slash
BASE_URL='http://localhost:7000'
MAX_SEARCH_RESULTS=20
PORT=7000
SUBX_BASE_URL='https://subx-api.duckdns.org'

# ── Logging ────────────────────────────────────────────────────────────────
# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# ── Valkey ─────────────────────────────────────────────────────────────────
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_MAX_MEMORY=1gb

# ── Cache ──────────────────────────────────────────────────────────────────
# Search cache TTL (seconds, default 900 = 15 min)
SEARCH_CACHE_TTL_SECONDS=900
# Subtitle hot cache TTL (seconds, default 604800 = 7 days)
SUBTITLE_CACHE_TTL_SECONDS=604800
# Persistent storage directory
CACHE_DIRECTORY=/cache/subtitles

# ── TMDB Prefetch ─────────────────────────────────────────────────────────
# Set to "true" to enable background subtitle prefetching for trending content
PREFETCH_ENABLED=false
# TMDB API key (v3) — required for fetching trending movies/TV shows
TMDB_API_KEY=your_tmdb_api_key_here
# Dedicated SubX API key used only by the prefetcher
SUBX_PREFETCH_API_KEY=your_subx_prefetch_key_here
# Interval between prefetch cycles in minutes (default: 10080 = 7 days — weekly)
PREFETCH_INTERVAL_MINUTES=10080
# Number of trending movies/TV shows to process per cycle (default: 10 per list)
PREFETCH_TRENDING_COUNT=10
# Number of subtitle files to download per title (default: 5)
PREFETCH_DOWNLOADS_PER_TITLE=5
# Number of recent episodes to pre-cache per trending TV show (default: 3)
PREFETCH_TV_EPISODES_PER_SEASON=3

# ── Container resource overrides (Docker Compose / Dockerfile) ─────────────
# These let you tune per-replica resources without editing YAML.
SUBX_CPU_LIMIT=1.0
SUBX_CPU_RESERVATION=0.25
SUBX_MEM_LIMIT=512M
SUBX_MEM_RESERVATION=128M
NODE_MAX_OLD_SPACE=256
