# Required: change this to a strong random secret
SECRET_WORD=change-me-to-a-strong-random-secret
# Without trailing slash
BASE_URL='http://localhost:7000'
MAX_SEARCH_RESULTS=20
PORT=7000
SUBX_BASE_URL='https://subx-api.duckdns.org'
# Empty for RAM cache only
CACHE_DIR='./cache'
CACHE_SEARCH_TTL=900
CACHE_DOWNLOAD_TTL=86400
# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# ── Container resource overrides (Docker Compose / Dockerfile) ──────────
# These let you tune per-replica resources without editing YAML.
# See comments in docker-compose.yml for replica-scenario recommendations.
# Next values are for a single-replica scenario handling heavy load.
# For multi-replica, reduce limits and reservations per replica.
# SUBX_CPU_LIMIT=2.0
# SUBX_CPU_RESERVATION=0.5
# SUBX_MEM_LIMIT=2048M
# SUBX_MEM_RESERVATION=512M
# NODE_MAX_OLD_SPACE=1024
